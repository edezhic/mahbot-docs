      {
        "pattern": "\\[heading \\d\\]",
        "example": "[heading 1]"
      },
      {
        "pattern": "\\[field[^\\]]*\\]",
        "example": "[field PAGE \\* MERGEFORMAT]"
      },
      {
        "pattern": "\\[(?:footnote|endnote|comment) (?:\\d+|\\?)(?: starts| ends)?\\]",
        "example": "[comment 1 starts]"
      },
      {
        "pattern": "Table \\d+(?: \\(formatting revised\\))?:",
        "example": "Table 1 (formatting revised):"
      },
      {
        "pattern": "(?:R\\d+|C\\d+)(?: \\([^)]*\\))?:",
        "example": "C2:"
      },
      {
        "pattern": "\\(spans C\\d+-C\\d+\\)",
        "example": "(spans C2-C4)"
      },
      {
        "pattern": "\\(part of R\\d+C\\d+\\)",
        "example": "(part of R3C2)"
      },
      {
        "pattern": "\\((?:inserted|deleted|merge revised|formatting revised)\\)",
        "example": "(merge revised)"
      },
      {
        "pattern": "\\(link: .*\\)",
        "example": "(link: internal)"
      },
      {
        "pattern": "(?:Footnote|Endnote|Comment) \\d+(?: \\([^)]*\\))?:",
        "example": "Footnote 1 (not referenced in the text):"
      },
      {
        "pattern": "(?:Header|Footer)(?: \\d+)? \\([^)]*\\):",
        "example": "Header 1 (first page):"
      },
      {
        "pattern": "Unaccepted tracked changes:",
        "example": "Unaccepted tracked changes: 1 insertion"
      },
      {
        "pattern": "\\(authors: [^)]*\\)",
        "example": "(authors: Anna)"
      },
      {
        "pattern": "Chart \\([^)]*\\):",
        "example": "Chart (column chart):"
      },
      {
        "pattern": "Series (?:\\d+|\"[^\"]*\"):",
        "example": "Series \"Revenue\":"
      },
      {
        "pattern": "\\(no values in the chart part\\)",
        "example": "(no values in the chart part)"
      },
      {
        "pattern": "\\(values only in the attached table\\)",
        "example": "(values only in the attached table)"
      },
      {
        "pattern": "\\(the chart part could not be read\\)",
        "example": "(the chart part could not be read)"
      },
      {
        "pattern": "\\(an extended chart kind[^)]*\\)",
        "example": "(an extended chart kind, not read)"
      },
      {
        "pattern": "\\(size [^)]*\\)",
        "example": "(size 12)"
      },
      {
        "pattern": "\\(stored number, format not shown\\)",
        "example": "(stored number, format not shown)"
      },
      {
        "pattern": "\\d+ more (?:series|value\\(s\\)|text\\(s\\))",
        "example": "3 more value(s)"
      }
